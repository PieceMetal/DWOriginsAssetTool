<Window x:Class="DWOriginsAssetTool.NameCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏正式命名目录" Icon="Assets/app-icon.ico" Width="1180" Height="760" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="游戏正式命名目录" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="SummaryText" Text="正在读取 KIDS 数据库……" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="导出 JSON" Click="ExportJson_Click" Style="{StaticResource GhostButtonStyle}"/>
        <Button Content="关闭" Click="Close_Click"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,16,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Height="40" Padding="12,8" TextChanged="Filter_Changed" ToolTip="搜索 Hero、Soldier、角色名、动作名、内部 ID 或来源数据库"/>
      <ComboBox x:Name="CategoryBox" Grid.Column="1" Margin="12,0,0,0" Height="40" SelectionChanged="Filter_Changed"/>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Background="#0D121A" ClipToBounds="True">
      <ListView x:Name="NameList" SelectionChanged="NameList_SelectionChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListView.View><GridView AllowsColumnReorder="False">
          <GridViewColumn Header="分类" Width="105" DisplayMemberBinding="{Binding Category}"/>
          <GridViewColumn Header="正式内部名称" Width="315" DisplayMemberBinding="{Binding OfficialName}"/>
          <GridViewColumn Header="中文备注" Width="145" DisplayMemberBinding="{Binding Annotation}"/>
          <GridViewColumn Header="内部 ID" Width="120" DisplayMemberBinding="{Binding InternalId}"/>
          <GridViewColumn Header="来源数据库" Width="280" DisplayMemberBinding="{Binding SourceDatabase}"/>
          <GridViewColumn Header="证据" Width="135" DisplayMemberBinding="{Binding Evidence}"/>
        </GridView></ListView.View>
      </ListView>
    </Border>
    <TextBlock Grid.Row="3" Text="已验证的实际资源引用" FontSize="14" FontWeight="SemiBold" Margin="2,12,0,8"/>
    <Border Grid.Row="4" Style="{StaticResource CardStyle}" Background="#0D121A" ClipToBounds="True">
      <ListView x:Name="BindingList" VirtualizingPanel.IsVirtualizing="True">
        <ListView.View><GridView AllowsColumnReorder="False">
          <GridViewColumn Header="类型" Width="90" DisplayMemberBinding="{Binding ResourceKind}"/>
          <GridViewColumn Header="资源 ID" Width="120" DisplayMemberBinding="{Binding ResourceId}"/>
          <GridViewColumn Header="实际文件" Width="470" DisplayMemberBinding="{Binding RelativePath}"/>
          <GridViewColumn Header="数据库证据链" Width="430" DisplayMemberBinding="{Binding EvidenceChain}"/>
        </GridView></ListView.View>
      </ListView>
    </Border>
    <Grid Grid.Row="5" Margin="2,12,2,0">
      <TextBlock x:Name="ResultText" Foreground="{StaticResource MutedBrush}"/>
      <TextBlock Text="只显示游戏文件中的真实明文；文件绑定结果另列，不把猜测当作正式名称。" HorizontalAlignment="Right" Foreground="#78869A"/>
    </Grid>
  </Grid>
</Window>
