<Window x:Class="DWOriginsAssetTool.UserGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用说明" Icon="Assets/app-icon.ico" Width="650" Height="650"
        MinWidth="560" MinHeight="560" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border Background="#101620" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="48" Height="48" CornerRadius="11" Background="#211B10" BorderBrush="#705627" BorderThickness="1" Margin="0,0,14,0">
          <Image Source="Assets/app-icon.png" Width="36" Height="36" Stretch="Uniform"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="真三国无双：起源 资源工作台" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="模型、动画与镜头资源预览和导出" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
      <StackPanel>
        <Border Background="#252416" BorderBrush="#705627" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="首次使用" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="首次使用时，在左侧选择包含 DWORIGINS.exe 和 File 文件夹的游戏目录，然后点击“初始化游戏资源”。初始化完成后，工具会恢复正式名称、角色/武器/动画分类和镜头关联。"
                       Foreground="#D5DCE6" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="基本操作" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,9"/>
        <Border Style="{StaticResource CardStyle}" Background="#111821" Padding="14" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="1   浏览与搜索" FontWeight="SemiBold"/>
            <TextBlock Text="在左侧目录树按正式名称浏览角色、武器、动画和镜头；也可以直接搜索角色名或资源名。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" Margin="22,4,0,10"/>
            <TextBlock Text="2   快捷预览" FontWeight="SemiBold"/>
            <TextBlock Text="在右侧“效果预览器”依次选择角色、武器和动画。切换武器时，动画列表会自动切换为对应的“角色 · 武器”动作集；选择带镜头标记的动画后，可切换为动画镜头。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" Margin="22,4,0,10"/>
            <TextBlock Text="3   视口操作" FontWeight="SemiBold"/>
            <TextBlock Text="通过视口顶部的“操作方式”选择鼠标方案。UE 动画编辑器：Alt+左键旋转、Alt+中键平移、Alt+右键推拉；默认编辑器：左键旋转、右键或中键平移、滚轮缩放。两种方式均可按 F 聚焦当前模型、按空格播放或暂停；拖动时间轴时会自动暂停。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" Margin="22,4,0,10"/>
            <TextBlock Text="4   动画与镜头" FontWeight="SemiBold"/>
            <TextBlock Text="使用底部时间轴播放或按住任意位置持续拖动。青色、黄色、紫色菱形分别表示镜头机位、观察目标、镜头参数的原始 K 帧；橙色方块表示已确认的摄像机配置/调用事件，灰蓝色方块表示普通动作或特效事件（不代表镜头效果），绿色色条表示配置持续区间。开启“吸附关键帧”后会优先定位附近原始 K 点或配置事件。镜头轨迹在载入后保持完整显示，播放循环和拖动时间轴只移动当前帧标记。勾选“镜头双视图”后才会分成左右视图，两边可分别选择自由镜头、动画镜头、配置镜头（本体模拟）或最终合成，并始终同步同一帧。配置镜头读取游戏本体 DefaultPlayer 字段，并恢复 GetLastCommitChangedCameraW2V → MatrixInverseAffine → VectorTransformNormal → FollowCamera2 的初始视角关系；切换前的已提交镜头方向会成为控制器初态，不继承角色技能的左右旋转。动作 Root 只提取相对首帧的前后位移。尚未完整恢复的《起源》战斗预设覆盖值、目标胶囊、敌人目标和地形碰撞会明确标记为近似，不冒充最终实机画面。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" Margin="22,4,0,10"/>
            <TextBlock Text="5   FBX 导出" FontWeight="SemiBold"/>
            <TextBlock Text="右下角可分别导出模型、角色动画和镜头动画。动画镜头、配置镜头和最终合成都按工具当前画面完整烘焙为 60 FPS 的机位、旋转、Roll 与 FOV；最终合成会同时烘焙动画镜头和配置层。文件会自动保存到工具 EXE 旁的 DWOrigins_Exports 文件夹。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" Margin="22,4,0,0"/>
            <TextBlock Text="6   任务进度" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <TextBlock Text="初始化资源时进度条显示在中央视口下方；加载动画时间轴后，导出进度会自动显示在时间轴正上方。任务完成或失败后会自动隐藏，不会挤压视口。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" Margin="22,4,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="Unreal Engine 导入" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,9"/>
        <Border Style="{StaticResource CardStyle}" Background="#111821" Padding="14" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="1   分别导入角色与武器模型 FBX；角色模型用于创建 Skeleton。" TextWrapping="Wrap" LineHeight="20"/>
            <TextBlock Text="2   导入角色动画 FBX 时关闭 Import Mesh，并选择角色模型创建的 Skeleton。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,5,0,0"/>
            <TextBlock Text="3   将武器 Skeletal Mesh Component 附加到人物 bone_0104。新版武器已经烘焙握持朝向，相对 Rotation 使用 0、Scale 使用 1。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,5,0,0"/>
            <TextBlock Text="4   测试新版导出时请删除 UE 中旧模型和旧 Skeleton 后重新导入，避免旧导入数据被继续复用。" Foreground="#E6B95C" TextWrapping="Wrap" LineHeight="20" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="FBX 导出环境" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,9"/>
        <Border Background="#171D25" BorderBrush="#705627" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="模型、动画和镜头的 FBX 导出需要免费软件 Blender。" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="工具会自动检测 Steam 版 Blender 和常见安装目录。若未检测到，可在主界面右下角点击“Steam 安装”或“官网下载”；安装完成后重新检测，或点击“选择程序”指定 blender.exe。Blender 只在导出 FBX 时使用，资源浏览和预览不需要它。"
                       Foreground="#C5CFDC" TextWrapping="Wrap" LineHeight="20" Margin="0,7,0,0"/>
          </StackPanel>
        </Border>

        <Border Background="#121B26" BorderBrush="#30445A" BorderThickness="1" CornerRadius="7" Padding="12">
          <TextBlock Text="提示：如果游戏根目录存在 DWOrigins_Unpacked，工具会优先读取该目录；否则直接读取游戏 File 目录。"
                     Foreground="#AFC3D8" TextWrapping="Wrap" LineHeight="20"/>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#141B25" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,13">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <CheckBox x:Name="DoNotShowAgainCheck" Content="下次启动时不再显示" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="开始使用" Style="{StaticResource AccentButtonStyle}" Click="Close_Click" MinWidth="112"/>
      </Grid>
    </Border>
  </Grid>
</Window>
