<Window x:Class="DWOriginsAssetTool.CameraCurveWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="镜头曲线查看器" Width="1180" Height="700" MinWidth="900" MinHeight="500"
 WindowStartupLocation="Manual" Background="#171A20" Foreground="#D6DEE9" KeyDown="Window_KeyDown">
 <Window.Resources>
  <Style TargetType="CheckBox"><EventSetter Event="PreviewMouseLeftButtonDown" Handler="ChannelCheck_MouseDown"/></Style>
  <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="#D6DEE9"/><Setter Property="Padding" Value="4,6"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#283340"/>
   <Setter Property="Foreground" Value="#E5EDF7"/>
   <Setter Property="BorderBrush" Value="#495D73"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="MinHeight" Value="30"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ButtonBorder" Property="Background" Value="#35495D"/>
        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#73BCE4"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="ButtonBorder" Property="Background" Value="#1D425A"/>
        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#91D7FF"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#91D7FF"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ButtonBorder" Property="Background" Value="#202730"/>
        <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#343F4C"/>
        <Setter Property="Foreground" Value="#778696"/>
        <Setter Property="Cursor" Value="Arrow"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,10"><TextBlock x:Name="TitleText" FontSize="16" Foreground="#83CFF4"/><TextBlock x:Name="SubtitleText" FontSize="11" Foreground="#8FA0B4" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,8">
   <StackPanel Orientation="Horizontal"><Button Content="适应全部 (F)" Click="Fit_Click"/><Button Content="适应当前区间" Click="FitValues_Click"/><CheckBox x:Name="FramesCheck" Content="帧数轴 (60 FPS)" Foreground="#D6DEE9" IsChecked="True" Click="DisplayOption_Changed" VerticalAlignment="Center"/></StackPanel>
   <TextBlock Text="左键定位 · 中键平移 · 滚轮缩放时间 · Shift+滚轮缩放数值 · Shift+左键框选放大" Foreground="#8FA0B4" FontSize="11" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="225" MinWidth="170"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#20242B" BorderBrush="#343B46" BorderThickness="1"><DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="镜头通道 · 勾选可叠加" Foreground="#8FA0B4" Margin="12"/>
    <TreeView Background="Transparent" BorderThickness="0" SelectedItemChanged="ChannelTree_SelectedItemChanged">
     <TreeViewItem Header="Camera" IsExpanded="True" Tag="all">
      <TreeViewItem Header="Transform" IsExpanded="True" Tag="transform">
       <TreeViewItem Header="位置 (cm)" IsExpanded="True" Tag="position"><TreeViewItem Tag="PositionX"><TreeViewItem.Header><CheckBox x:Name="PositionXCheck" Content="X" Foreground="#FF6B6B" IsChecked="false" Click="DisplayOption_Changed"/></TreeViewItem.Header></TreeViewItem>
<TreeViewItem Tag="PositionY"><TreeViewItem.Header><CheckBox x:Name="PositionYCheck" Content="Y" Foreground="#71D889" IsChecked="false" Click="DisplayOption_Changed"/></TreeViewItem.Header></TreeViewItem>
<TreeViewItem Tag="PositionZ"><TreeViewItem.Header><CheckBox x:Name="PositionZCheck" Content="Z" Foreground="#62A8FF" IsChecked="false" Click="DisplayOption_Changed"/></TreeViewItem.Header></TreeViewItem></TreeViewItem>
       <TreeViewItem Header="旋转 (°)" IsExpanded="True" Tag="rotation"><TreeViewItem Tag="Pitch"><TreeViewItem.Header><CheckBox x:Name="PitchCheck" Content="Pitch" Foreground="#FFB454" IsChecked="false" Click="DisplayOption_Changed"/></TreeViewItem.Header></TreeViewItem>
<TreeViewItem Tag="Yaw"><TreeViewItem.Header><CheckBox x:Name="YawCheck" Content="Yaw" Foreground="#F06FC3" IsChecked="false" Click="DisplayOption_Changed"/></TreeViewItem.Header></TreeViewItem>
<TreeViewItem Tag="Roll"><TreeViewItem.Header><CheckBox x:Name="RollCheck" Content="Roll" Foreground="#E5E86B" IsChecked="false" Click="DisplayOption_Changed"/></TreeViewItem.Header></TreeViewItem></TreeViewItem>
      </TreeViewItem><TreeViewItem Tag="Fov"><TreeViewItem.Header><CheckBox x:Name="FovCheck" Content="FOV (°)" Foreground="#B97AEC" IsChecked="true" Click="DisplayOption_Changed"/></TreeViewItem.Header></TreeViewItem>
<TreeViewItem Tag="Distance"><TreeViewItem.Header><CheckBox x:Name="DistanceCheck" Content="距离 (cm)" Foreground="#58D2EC" IsChecked="true" Click="DisplayOption_Changed"/></TreeViewItem.Header></TreeViewItem>
     </TreeViewItem>
    </TreeView>
   </DockPanel></Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#343B46"/>
   <Border Grid.Column="2" Background="#13171D" ClipToBounds="True" BorderBrush="#343B46" BorderThickness="1">
    <Canvas x:Name="CurveCanvas" Background="#13171D" SizeChanged="CurveCanvas_SizeChanged" MouseLeftButtonDown="CurveCanvas_MouseLeftButtonDown" MouseMove="CurveCanvas_MouseMove" MouseLeftButtonUp="CurveCanvas_MouseLeftButtonUp" LostMouseCapture="CurveCanvas_LostMouseCapture" MouseDown="CurveCanvas_MouseDown" MouseUp="CurveCanvas_MouseUp" MouseWheel="CurveCanvas_MouseWheel"/>
   </Border>
  </Grid>
  <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="InfoText" Foreground="#AFC0D3" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/><TextBlock x:Name="RangeText" Grid.Column="1" Foreground="#8FA0B4" FontSize="11" Margin="12,0,0,0"/></Grid>
 </Grid>
</Window>
