<Window x:Class="DWOriginsAssetTool.CameraCurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="镜头曲线查看器"
        Width="920" Height="620" MinWidth="720" MinHeight="460"
        WindowStartupLocation="Manual"
        Background="#0F151E" Foreground="#D6DEE9">
  <Border BorderBrush="#3B6A7C" BorderThickness="1" CornerRadius="8" Background="#F2131A24" Padding="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="TitleText" Text="镜头曲线" Foreground="#83CFF4" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubtitleText" Text="按当前动作 60 FPS 采样；只显示本体已恢复或当前预览实际计算出的参数。" Foreground="#8FA0B4" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <CheckBox x:Name="FovCheck" Content="视野角度" IsChecked="True" Click="DisplayOption_Changed" Margin="0,0,12,0"/>
          <CheckBox x:Name="DistanceCheck" Content="镜头距离" IsChecked="True" Click="DisplayOption_Changed" Margin="0,0,12,0"/>
          <CheckBox x:Name="CameraSpeedCheck" Content="机位速度" IsChecked="False" Click="DisplayOption_Changed" Margin="0,0,12,0"/>
          <CheckBox x:Name="TargetSpeedCheck" Content="目标速度" IsChecked="False" Click="DisplayOption_Changed"/>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
        <TextBlock Text="● 视野角度" Foreground="#B97AEC" Margin="0,0,14,0"/>
        <TextBlock Text="● 镜头距离" Foreground="#58D2EC" Margin="0,0,14,0"/>
        <TextBlock Text="● 机位速度(cm/s)" Foreground="#FF7E7E" Margin="0,0,14,0"/>
        <TextBlock Text="● 目标速度(cm/s)" Foreground="#7EA2FF" Margin="0,0,14,0"/>
        <TextBlock Text="◆ 原始 K 帧" Foreground="#FFFFFF" Margin="0,0,14,0"/>
        <TextBlock Text="■ 动作事件" Foreground="#60758D"/>
      </StackPanel>

      <Border Grid.Row="2" Background="#0B1118" BorderBrush="#26384C" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <Canvas x:Name="CurveCanvas" Background="#0B1118" Cursor="SizeWE"
                SizeChanged="CurveCanvas_SizeChanged"
                MouseLeftButtonDown="CurveCanvas_MouseLeftButtonDown"
                MouseMove="CurveCanvas_MouseMove"
                MouseLeftButtonUp="CurveCanvas_MouseLeftButtonUp"
                LostMouseCapture="CurveCanvas_LostMouseCapture"/>
      </Border>

      <Grid Grid.Row="3" Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="InfoText" Foreground="#AFC0D3" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock x:Name="RangeText" Grid.Column="1" Foreground="#8FA0B4" FontFamily="Consolas" FontSize="11" Margin="14,0,0,0"/>
      </Grid>
    </Grid>
  </Border>
</Window>
