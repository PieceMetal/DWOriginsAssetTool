<Window x:Class="DWOriginsAssetTool.CameraDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="动画镜头逐帧数据"
        Width="560" Height="620" MinWidth="460" MinHeight="360"
        WindowStartupLocation="Manual"
        Background="#0F151E" Foreground="#D6DEE9">
  <Border BorderBrush="#3B6A7C" BorderThickness="1" CornerRadius="8" Background="#F2131A24" Padding="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="当前帧动画镜头数据" Foreground="#83CFF4" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="ModeText" Grid.Column="1" Foreground="#F1BE48" FontSize="11" VerticalAlignment="Center"/>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,8,0,8">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
          <TextBlock Text="●" Foreground="#58D2EC" FontSize="11"/><TextBlock Text="机位" Foreground="#AFC0D3" FontSize="10" Margin="3,0,10,0"/>
          <TextBlock Text="●" Foreground="#F2B848" FontSize="11"/><TextBlock Text="镜头目标" Foreground="#AFC0D3" FontSize="10" Margin="3,0,10,0"/>
          <TextBlock Text="●" Foreground="#B97AEC" FontSize="11"/><TextBlock Text="镜头参数" Foreground="#AFC0D3" FontSize="10"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="◆" Foreground="#58D2EC" FontSize="11"/><TextBlock Text="原始 K 帧" Foreground="#AFC0D3" FontSize="10" Margin="3,0,10,0"/>
          <TextBlock Text="■" Foreground="#60758D" FontSize="9"/><TextBlock Text="动作/特效事件" Foreground="#AFC0D3" FontSize="10"/>
        </StackPanel>
      </StackPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="DataText" Foreground="#D6DEE9" FontFamily="Consolas" FontSize="12"
                   LineHeight="18" TextWrapping="Wrap"/>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
